{
  "name": "liftlog",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "scripts": {
    "predev": "node scripts/catalog.mjs build",
    "dev": "vite",
    "prebuild": "node scripts/catalog.mjs build",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc -b",
    "catalog:validate": "node scripts/catalog.mjs validate",
    "catalog:build": "node scripts/catalog.mjs build",
    "catalog:links": "node scripts/catalog.mjs links"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource/oswald": "^5.3.0",
    "@supabase/supabase-js": "^2.118.0",
    "preact": "^10.29.8"
  },
  "devDependencies": {
    "@preact/preset-vite": "^2.10.6",
    "@types/node": "^26.6.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.0.5"
  },
  "license": "MIT",
  "description": "A private, offline-ready workout tracker you host yourself, with 124 exercises and your own database.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/boardotmeme-dot/liftlog.git"
  },
  "homepage": "https://github.com/boardotmeme-dot/liftlog#readme",
  "bugs": {
    "url": "https://github.com/boardotmeme-dot/liftlog/issues"
  },
  "keywords": [
    "workout",
    "fitness",
    "gym",
    "pwa",
    "supabase",
    "vercel",
    "open-source",
    "self-hosted"
  ],
  "engines": {
    "node": ">=20"
  }
